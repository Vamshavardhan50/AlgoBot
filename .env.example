# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=

# ── Scheduler Defaults ───────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
CONTEST_ALERT_TIME=08:00
POTD_ALERT_TIME=09:00
CONTEST_REMINDER_WINDOW=30
COOLDOWN_SECONDS=3

# ── Storage ──────────────────────────────────────────────────────────────────
DB_PATH=data/algobot.db

# ── Health Endpoint ──────────────────────────────────────────────────────────
PORT=3000
HEALTH_ENDPOINT=true
